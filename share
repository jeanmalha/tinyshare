#!/usr/bin/env bash
# tinyshare — upload files to S3 and generate time-limited share URLs.
#
# Usage:
#   share setup                        One-time AWS infrastructure setup (CloudFormation)
#   share <file> [duration]            Upload and print a share URL
#   share <file> [duration] --alias=NAME  Upload with a custom vanity alias
#   share list                         List all shares
#   share revoke <token|alias>         Delete a share immediately
#   share teardown                     Destroy all AWS infrastructure
#   share delete-config                Remove local config only (keeps AWS resources)
#   share uninstall                    Remove share from PATH
#   share help                         Show this help
#
# Duration: 1h, 6h, 24h (default), 7d, 30d  (max 30d)
set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/tinyshare"
CONFIG_FILE="$CONFIG_DIR/config.env"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BOLD='\033[1m'; NC='\033[0m'
info()    { echo -e "${GREEN}▶${NC} $*"; }
warn()    { echo -e "${YELLOW}⚠${NC}  $*"; }
die()     { printf '\nError: %s\n\n' "$*" >&2; exit 1; }
confirm() { read -r -p "$1 [y/N] " _ans; [[ "$_ans" =~ ^[Yy]$ ]]; }

trap 'printf "\nError on line %s: %s\n\n" "$LINENO" "$BASH_COMMAND" >&2' ERR

load_config() {
    [[ -f "$CONFIG_FILE" ]] || die "Not configured — run: share setup"
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
    [[ -n "${TINYSHARE_AWS_PROFILE:-}" ]] && export AWS_PROFILE="$TINYSHARE_AWS_PROFILE"
}

# ── Helpers ───────────────────────────────────────────────────────────────────

parse_duration() {
    local dur="${1:-24h}"
    if [[ "$dur" =~ ^([0-9]+)([hHdDmM])$ ]]; then
        local num="${BASH_REMATCH[1]}" unit
        unit=$(echo "${BASH_REMATCH[2]}" | tr '[:upper:]' '[:lower:]')
        case "$unit" in
            m) echo $(( num * 60 )) ;;
            h) echo $(( num * 3600 )) ;;
            d) echo $(( num * 86400 )) ;;
        esac
    else
        die "Invalid duration '$dur'. Use e.g.: 1h, 24h, 7d"
    fi
}

random_token() {
    LC_ALL=C tr -dc 'a-zA-Z0-9' < /dev/urandom | head -c 8 || true
}

guess_mime() {
    python3 -c "
import mimetypes, sys
t, _ = mimetypes.guess_type(sys.argv[1])
print(t or 'application/octet-stream')
" "$1"
}

format_expiry() {
    date -r "$1" '+%Y-%m-%d %H:%M UTC' 2>/dev/null \
        || date -d "@$1" '+%Y-%m-%d %H:%M UTC' 2>/dev/null \
        || echo "(expires: $1)"
}

show_qr() {
    if ! command -v qrencode &>/dev/null; then
        warn "qrencode not found — install it to display QR codes:"
        echo "    macOS:  brew install qrencode"
        echo "    Linux:  sudo apt install qrencode"
        return
    fi
    echo ""
    qrencode -t UTF8 -m 1 "$1"
}

copy_to_clipboard() {
    if command -v pbcopy &>/dev/null; then
        echo -n "$1" | pbcopy 2>/dev/null \
            && echo -e "  ${YELLOW}↗${NC} Copied to clipboard" || true
    elif command -v xclip &>/dev/null; then
        echo -n "$1" | xclip -selection clipboard 2>/dev/null \
            && echo -e "  ${YELLOW}↗${NC} Copied to clipboard" || true
    fi
}

find_template() {
    local data_dir="${XDG_DATA_HOME:-$HOME/.local/share}/tinyshare"
    if [[ -f "$data_dir/template.yaml" ]]; then
        echo "$data_dir/template.yaml"
    elif [[ -f "$(dirname "$0")/../share/tinyshare/template.yaml" ]]; then
        echo "$(dirname "$0")/../share/tinyshare/template.yaml"
    else
        die "template.yaml not found — re-run install.sh to restore it"
    fi
}

# ── setup ─────────────────────────────────────────────────────────────────────

cmd_setup() {
    echo ""
    echo "  tinyshare setup"
    echo "  ───────────────"
    echo ""

    command -v aws &>/dev/null || die "aws CLI not found — install it: https://aws.amazon.com/cli/"
    command -v python3 &>/dev/null || die "python3 not found"

    if [[ -f "$CONFIG_FILE" ]]; then
        warn "Already configured ($CONFIG_FILE exists)."
        confirm "Re-run setup and overwrite?" || exit 0
    fi

    # ── AWS profile ───────────────────────────────────────────────────────────
    local profiles profile_count PROFILE
    profiles=()
    while IFS= read -r _line; do [[ -n "$_line" ]] && profiles+=("$_line"); done \
        < <(aws configure list-profiles 2>/dev/null || echo "default")
    profile_count=${#profiles[@]}

    if (( profile_count == 1 )); then
        PROFILE="${profiles[0]}"
        echo "  AWS profile: ${BOLD}${PROFILE}${NC}"
    else
        echo "  AWS profiles:"
        for i in "${!profiles[@]}"; do
            printf "    [%d] %s\n" $(( i + 1 )) "${profiles[$i]}"
        done
        echo ""
        read -r -p "  Select profile [1]: " _idx
        _idx="${_idx:-1}"
        [[ "$_idx" =~ ^[0-9]+$ ]] && (( _idx >= 1 && _idx <= profile_count )) \
            || die "Invalid selection"
        PROFILE="${profiles[$(( _idx - 1 ))]}"
    fi
    export AWS_PROFILE="$PROFILE"
    echo ""

    # ── Route 53 hosted zones ─────────────────────────────────────────────────
    info "Fetching Route 53 hosted zones..."
    local zones_json zone_names zone_ids zone_count
    zones_json=$(aws route53 list-hosted-zones \
        --query 'HostedZones[*].{name:Name,id:Id}' --output json)
    zone_names=()
    while IFS= read -r _line; do [[ -n "$_line" ]] && zone_names+=("$_line"); done \
        < <(echo "$zones_json" | python3 -c "
import sys, json
for z in json.load(sys.stdin): print(z['name'].rstrip('.'))
")
    zone_ids=()
    while IFS= read -r _line; do [[ -n "$_line" ]] && zone_ids+=("$_line"); done \
        < <(echo "$zones_json" | python3 -c "
import sys, json
for z in json.load(sys.stdin): print(z['id'].replace('/hostedzone/', ''))
")
    zone_count=${#zone_names[@]}
    (( zone_count > 0 )) || die "No hosted zones found — create one in Route 53 first"

    echo ""
    echo "  Route 53 domains:"
    for i in "${!zone_names[@]}"; do
        printf "    [%d] %s\n" $(( i + 1 )) "${zone_names[$i]}"
    done
    echo ""
    read -r -p "  Select domain [1]: " _idx
    _idx="${_idx:-1}"
    [[ "$_idx" =~ ^[0-9]+$ ]] && (( _idx >= 1 && _idx <= zone_count )) \
        || die "Invalid selection"

    local BASE_DOMAIN HOSTED_ZONE_ID
    BASE_DOMAIN="${zone_names[$(( _idx - 1 ))]}"
    HOSTED_ZONE_ID="${zone_ids[$(( _idx - 1 ))]}"

    read -r -p "  Subdomain prefix (leave empty to use apex domain): " _sub
    _sub=$(echo "$_sub" | tr '[:upper:]' '[:lower:]')
    _sub="${_sub%%.*}"
    local DOMAIN
    if [[ -z "$_sub" ]]; then
        DOMAIN="$BASE_DOMAIN"
    else
        DOMAIN="${_sub}.${BASE_DOMAIN}"
    fi

    local BUCKET_NAME STACK_NAME
    BUCKET_NAME="tinyshare-$(echo "$DOMAIN" | tr '.' '-')"
    STACK_NAME="$BUCKET_NAME"

    echo ""
    info "Domain:  $DOMAIN"
    info "Stack:   $STACK_NAME  (CloudFormation, us-east-1)"
    info "Bucket:  $BUCKET_NAME"
    info "Profile: $PROFILE"
    echo ""
    confirm "Proceed?" || exit 0
    echo ""

    # ── Deploy CloudFormation stack ───────────────────────────────────────────
    local CF_TEMPLATE
    CF_TEMPLATE=$(find_template)

    info "Deploying CloudFormation stack..."
    info "(ACM validation + CloudFront deployment takes ~10 minutes)"
    echo ""
    aws cloudformation deploy \
        --stack-name "$STACK_NAME" \
        --template-file "$CF_TEMPLATE" \
        --parameter-overrides \
            "Domain=$DOMAIN" \
            "HostedZoneId=$HOSTED_ZONE_ID" \
            "BucketName=$BUCKET_NAME" \
        --tags "tinyshare:managed=true" \
        --region us-east-1 \
        --no-fail-on-empty-changeset

    # ── Get stack outputs ─────────────────────────────────────────────────────
    local OUTPUTS DIST_ID KVS_ARN
    OUTPUTS=$(aws cloudformation describe-stacks \
        --stack-name "$STACK_NAME" \
        --region us-east-1 \
        --query 'Stacks[0].Outputs' \
        --output json)
    DIST_ID=$(echo "$OUTPUTS" | python3 -c "
import sys, json
o = {x['OutputKey']: x['OutputValue'] for x in json.load(sys.stdin)}
print(o.get('DistributionId', ''))
")
    KVS_ARN=$(echo "$OUTPUTS" | python3 -c "
import sys, json
o = {x['OutputKey']: x['OutputValue'] for x in json.load(sys.stdin)}
print(o.get('KeyValueStoreArn', ''))
")

    # ── Save config ───────────────────────────────────────────────────────────
    mkdir -p "$CONFIG_DIR"
    {
        echo "TINYSHARE_BUCKET=$BUCKET_NAME"
        echo "TINYSHARE_DOMAIN=$DOMAIN"
        echo "TINYSHARE_REGION=us-east-1"
        echo "TINYSHARE_CF_DIST_ID=$DIST_ID"
        echo "TINYSHARE_CF_STACK=$STACK_NAME"
        echo "TINYSHARE_AWS_PROFILE=$PROFILE"
        [[ -n "$KVS_ARN" ]] && echo "TINYSHARE_KVS_ARN=$KVS_ARN"
    } > "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"

    echo ""
    printf '  Setup complete!\n'
    echo ""
    echo "    https://$DOMAIN"
    echo ""
    echo "  Try it:  share myfile.pdf 7d"
    echo ""
}

# ── upload ────────────────────────────────────────────────────────────────────

cmd_upload() {
    load_config
    local file="$1"
    shift
    local duration="24h" QR=0 ALIAS=""
    for _arg in "$@"; do
        case "$_arg" in
            --qr)       QR=1 ;;
            --alias=*)  ALIAS="${_arg#--alias=}" ;;
            *)          duration="$_arg" ;;
        esac
    done

    [[ -f "$file" ]] || die "File not found: $file"

    local seconds expiry token mime filename s3_key url tier
    seconds=$(parse_duration "$duration")
    (( seconds <= 2592000 )) || die "Maximum duration is 30d"

    expiry=$(( $(date +%s) + seconds ))
    token=$(random_token)
    mime=$(guess_mime "$file")
    filename=$(basename "$file")
    s3_key="${expiry}/${token}"
    url="https://${TINYSHARE_DOMAIN}/${expiry}/${token}"

    if (( seconds <= 86400 )); then tier="1d"
    elif (( seconds <= 604800 )); then tier="7d"
    else tier="30d"
    fi

    # Validate alias before uploading
    if [[ -n "$ALIAS" ]]; then
        [[ "$ALIAS" =~ ^[a-zA-Z0-9-]{2,32}$ ]] \
            || die "Alias must be 2–32 characters, letters/numbers/hyphens only"
        if [[ -n "${TINYSHARE_KVS_ARN:-}" ]]; then
            if aws cloudfront-keyvaluestore get-key \
                    --kvs-arn "$TINYSHARE_KVS_ARN" --key "$ALIAS" \
                    &>/dev/null; then
                die "Alias '$ALIAS' is already taken"
            fi
        else
            warn "TINYSHARE_KVS_ARN not set — alias will not be registered in KVS"
        fi
    fi

    # Build metadata string
    local metadata="filename=${filename}"
    [[ -n "$ALIAS" ]] && metadata="${metadata},alias=${ALIAS}"

    info "Uploading $(du -sh "$file" | cut -f1) ..."
    local _upload_err
    if ! _upload_err=$(aws s3 cp "$file" "s3://${TINYSHARE_BUCKET}/${s3_key}" \
        --region "$TINYSHARE_REGION" \
        --content-type "$mime" \
        --content-disposition "attachment; filename=\"${filename}\"" \
        --metadata "$metadata" \
        --no-progress 2>&1); then
        die "Upload failed: $_upload_err"
    fi
    aws s3api put-object-tagging \
        --bucket "$TINYSHARE_BUCKET" \
        --key "$s3_key" \
        --region "$TINYSHARE_REGION" \
        --tagging "{\"TagSet\":[{\"Key\":\"expiry-tier\",\"Value\":\"${tier}\"}]}" \
        2>/dev/null || true

    # Register alias in KVS
    if [[ -n "$ALIAS" && -n "${TINYSHARE_KVS_ARN:-}" ]]; then
        local kvs_etag
        kvs_etag=$(aws cloudfront-keyvaluestore describe-key-value-store \
            --kvs-arn "$TINYSHARE_KVS_ARN" \
            --query 'ETag' --output text)
        aws cloudfront-keyvaluestore put-key \
            --kvs-arn "$TINYSHARE_KVS_ARN" \
            --key "$ALIAS" \
            --value "$s3_key" \
            --if-match "$kvs_etag" > /dev/null
    fi

    echo ""
    printf '  \033[1m%s\033[0m\n' "$url"
    if [[ -n "$ALIAS" ]]; then
        local alias_url="https://${TINYSHARE_DOMAIN}/${ALIAS}"
        printf '  \033[1m%s\033[0m  (alias — live in ~5 min)\n' "$alias_url"
    fi
    printf '  Expires: %s\n' "$(format_expiry "$expiry")"
    echo ""
    if [[ -n "$ALIAS" ]]; then
        copy_to_clipboard "https://${TINYSHARE_DOMAIN}/${ALIAS}"
    else
        copy_to_clipboard "$url"
    fi
    (( QR )) && show_qr "$url"
    echo ""
}

# ── list ──────────────────────────────────────────────────────────────────────

cmd_list() {
    load_config
    local now
    now=$(date +%s)

    echo ""
    printf "  %-8s  %-24s  %-14s  %-20s  %s\n" "STATUS" "FILE" "ALIAS" "EXPIRES" "URL"
    printf "  %s\n" "──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────"

    local found=0
    while IFS= read -r line; do
        local key expiry token meta filename alias_val expiry_human url
        key=$(echo "$line" | awk '{print $NF}')
        expiry=$(echo "$key" | cut -d/ -f1)
        token=$(echo "$key" | cut -d/ -f2)
        [[ "$expiry" =~ ^[0-9]{10}$ ]] || continue
        [[ "$token" =~ ^[A-Za-z0-9]{8}$ ]] || continue

        meta=$(aws s3api head-object \
            --bucket "$TINYSHARE_BUCKET" --key "$key" \
            --region "$TINYSHARE_REGION" \
            --query 'Metadata' --output json 2>/dev/null || echo '{}')
        filename=$(echo "$meta" | python3 -c "
import sys, json
m = json.load(sys.stdin) or {}
print(m.get('filename', '') or '')
" 2>/dev/null || true)
        alias_val=$(echo "$meta" | python3 -c "
import sys, json
m = json.load(sys.stdin) or {}
print(m.get('alias', '') or '')
" 2>/dev/null || true)
        [[ -z "$filename" || "$filename" == "None" ]] && filename="(unknown)"
        [[ "$alias_val" == "None" ]] && alias_val=""

        url="https://${TINYSHARE_DOMAIN}/${key}"
        expiry_human=$(format_expiry "$expiry")

        if (( now > expiry )); then
            printf "  ${RED}%-8s${NC}  %-24s  %-14s  %-20s  %s\n" "expired" "${filename:0:24}" "${alias_val:0:14}" "$expiry_human" "$url"
        else
            printf "  ${GREEN}%-8s${NC}  %-24s  %-14s  %-20s  %s\n" "active" "${filename:0:24}" "${alias_val:0:14}" "$expiry_human" "$url"
        fi
        found=$(( found + 1 ))
    done < <(aws s3 ls "s3://${TINYSHARE_BUCKET}/" --recursive --region "$TINYSHARE_REGION" 2>/dev/null)

    if (( found == 0 )); then
        echo "  No shares found."
    fi
    echo ""
}

# ── revoke ────────────────────────────────────────────────────────────────────

cmd_revoke() {
    load_config
    local arg="${1:-}"
    [[ -n "$arg" ]] || die "Usage: share revoke <token|alias>"

    local key
    # If arg doesn't look like an 8-char token, treat it as an alias
    if [[ ! "$arg" =~ ^[A-Za-z0-9]{8}$ ]] && [[ -n "${TINYSHARE_KVS_ARN:-}" ]]; then
        local alias_key
        alias_key=$(aws cloudfront-keyvaluestore get-key \
            --kvs-arn "$TINYSHARE_KVS_ARN" --key "$arg" \
            --query 'Value' --output text 2>/dev/null || true)
        [[ -n "$alias_key" && "$alias_key" != "None" ]] || die "Alias not found: $arg"
        key="$alias_key"
    else
        key=$(aws s3 ls "s3://${TINYSHARE_BUCKET}/" --recursive --region "$TINYSHARE_REGION" \
            | awk '{print $NF}' | grep "/${arg}$" | head -1)
        [[ -n "$key" ]] || die "Share not found: $arg"
    fi

    # Read alias from S3 metadata before deleting
    local meta alias_val
    meta=$(aws s3api head-object \
        --bucket "$TINYSHARE_BUCKET" --key "$key" \
        --region "$TINYSHARE_REGION" \
        --query 'Metadata' --output json 2>/dev/null || echo '{}')
    alias_val=$(echo "$meta" | python3 -c "
import sys, json
m = json.load(sys.stdin) or {}
print(m.get('alias', '') or '')
" 2>/dev/null || true)
    [[ "$alias_val" == "None" ]] && alias_val=""

    aws s3 rm "s3://${TINYSHARE_BUCKET}/${key}" --region "$TINYSHARE_REGION" > /dev/null
    aws cloudfront create-invalidation \
        --distribution-id "$TINYSHARE_CF_DIST_ID" \
        --paths "/${key}" > /dev/null

    # Clean up KVS alias entry if present
    if [[ -n "$alias_val" && -n "${TINYSHARE_KVS_ARN:-}" ]]; then
        local kvs_etag
        kvs_etag=$(aws cloudfront-keyvaluestore describe-key-value-store \
            --kvs-arn "$TINYSHARE_KVS_ARN" \
            --query 'ETag' --output text 2>/dev/null || true)
        if [[ -n "$kvs_etag" && "$kvs_etag" != "None" ]]; then
            aws cloudfront-keyvaluestore delete-key \
                --kvs-arn "$TINYSHARE_KVS_ARN" \
                --key "$alias_val" \
                --if-match "$kvs_etag" > /dev/null 2>/dev/null || true
        fi
    fi

    info "Revoked: $arg"
}

# ── logs ──────────────────────────────────────────────────────────────────────

cmd_logs() {
    load_config
    local filter="${1:-}"
    local log_bucket="${TINYSHARE_BUCKET}-logs"

    echo ""

    # Collect recent log files (last ~100 = ~4 days of traffic)
    local files=()
    while IFS= read -r _line; do
        local _fname
        _fname=$(echo "$_line" | awk '{print $NF}')
        [[ "$_fname" =~ \.gz$ ]] && files+=("$_fname")
    done < <(aws s3 ls "s3://${log_bucket}/cf/" --recursive --region us-east-1 2>/dev/null | tail -100)

    if (( ${#files[@]} == 0 )); then
        echo "  No logs yet — CloudFront delivers logs within ~1 hour of first access."
        echo "  Log bucket: s3://${log_bucket}/cf/"
        echo ""
        return
    fi

    [[ -n "$filter" ]] && info "Filtering for: $filter" && echo ""
    printf "  %-19s  %-15s  %-6s  %-14s  %-24s  %-32s  %s\n" \
        "DATE/TIME (UTC)" "IP" "STATUS" "EDGE" "FILE" "USER AGENT" "TOKEN"
    printf "  %s\n" \
        "──────────────────────────────────────────────────────────────────────────────────────────────────────────"

    local tmp_dir found=0
    tmp_dir=$(mktemp -d /tmp/tinyshare-logs.XXXXXX)

    # Build token→filename map from S3 object metadata
    local _map="${tmp_dir}/_names.tsv"
    touch "$_map"
    while IFS= read -r _key; do
        local _tok _fn
        _tok="${_key##*/}"
        _fn=$(aws s3api head-object \
            --bucket "$TINYSHARE_BUCKET" --key "$_key" \
            --region "$TINYSHARE_REGION" \
            --query 'Metadata.filename' --output text 2>/dev/null || true)
        [[ -n "$_fn" && "$_fn" != "None" ]] && printf '%s\t%s\n' "$_tok" "$_fn" >> "$_map"
    done < <(aws s3 ls "s3://${TINYSHARE_BUCKET}/" --recursive \
        --region "$TINYSHARE_REGION" 2>/dev/null | \
        awk '{print $NF}' | grep -E '^[0-9]{10}/[A-Za-z0-9]{8}$'; true)

    for _fname in "${files[@]}"; do
        local _local="${tmp_dir}/${_fname##*/}"
        aws s3 cp "s3://${log_bucket}/${_fname}" "$_local" \
            --region us-east-1 --quiet 2>/dev/null || continue

        while IFS= read -r _row; do
            printf '%s\n' "$_row"
            found=$(( found + 1 ))
        done < <(python3 -c "
import sys, gzip, urllib.parse, re
logfile, filt, map_file = sys.argv[1], sys.argv[2], sys.argv[3]
names = {}
with open(map_file) as mf:
    for ln in mf:
        parts = ln.rstrip('\n').split('\t', 1)
        if len(parts) == 2: names[parts[0]] = parts[1]
share_re = re.compile(r'^/\d{10}/([A-Za-z0-9]{8})')
try:
    with gzip.open(logfile, 'rt', errors='replace') as f:
        for line in f:
            if line.startswith('#') or not line.strip(): continue
            p = line.strip().split('\t')
            if len(p) < 11: continue
            date, time, edge, ip = p[0], p[1][:8], p[2], p[4]
            uri, status, ua = p[7], p[8], p[10]
            m = share_re.match(uri)
            if not m: continue
            token = m.group(1)
            if filt and filt not in uri: continue
            ua = urllib.parse.unquote(ua)[:32]
            fname = names.get(token, '')[:24]
            print(f'  {date} {time}  {ip:<15}  {status:<6}  {edge:<14}  {fname:<24}  {ua:<32}  {token}')
except Exception:
    pass
" "$_local" "$filter" "$_map" 2>/dev/null || true)
    done

    rm -rf "$tmp_dir"

    echo ""
    if (( found == 0 )); then
        echo "  No matching requests found."
    else
        printf "  %d request(s) shown (up to ~4 days, newest last).\n" "$found"
    fi
    echo ""
}

# ── stats ─────────────────────────────────────────────────────────────────────

cmd_stats() {
    load_config
    local filter="${1:-}"
    local log_bucket="${TINYSHARE_BUCKET}-logs"

    echo ""

    local files=()
    while IFS= read -r _line; do
        local _fname
        _fname=$(echo "$_line" | awk '{print $NF}')
        [[ "$_fname" =~ \.gz$ ]] && files+=("$_fname")
    done < <(aws s3 ls "s3://${log_bucket}/cf/" --recursive --region us-east-1 2>/dev/null | tail -744)

    if (( ${#files[@]} == 0 )); then
        echo "  No logs yet — CloudFront delivers logs within ~1 hour of first access."
        echo ""
        return
    fi

    local file_count=${#files[@]}
    info "Processing ${file_count} log file(s)..."
    [[ -n "$filter" ]] && info "Filtering for: $filter"
    echo ""

    local tmp_dir
    tmp_dir=$(mktemp -d /tmp/tinyshare-stats.XXXXXX)

    for _fname in "${files[@]}"; do
        aws s3 cp "s3://${log_bucket}/${_fname}" "${tmp_dir}/${_fname##*/}" \
            --region us-east-1 --quiet 2>/dev/null || true
    done

    # Build token→filename map from S3 object metadata
    local _map="${tmp_dir}/_names.tsv"
    touch "$_map"
    while IFS= read -r _key; do
        local _tok _fn
        _tok="${_key##*/}"
        _fn=$(aws s3api head-object \
            --bucket "$TINYSHARE_BUCKET" --key "$_key" \
            --region "$TINYSHARE_REGION" \
            --query 'Metadata.filename' --output text 2>/dev/null || true)
        [[ -n "$_fn" && "$_fn" != "None" ]] && printf '%s\t%s\n' "$_tok" "$_fn" >> "$_map"
    done < <(aws s3 ls "s3://${TINYSHARE_BUCKET}/" --recursive \
        --region "$TINYSHARE_REGION" 2>/dev/null | \
        awk '{print $NF}' | grep -E '^[0-9]{10}/[A-Za-z0-9]{8}$'; true)

    python3 - "$tmp_dir" "$filter" "$_map" <<'PYEOF'
import sys, gzip, os, urllib.parse
from collections import defaultdict, Counter

tmp_dir, filt, map_file = sys.argv[1], sys.argv[2], sys.argv[3]
names = {}
with open(map_file) as mf:
    for ln in mf:
        parts = ln.rstrip('\n').split('\t', 1)
        if len(parts) == 2: names[parts[0]] = parts[1]

hits   = defaultdict(int)
uniq   = defaultdict(set)
first  = {}
last   = {}
status_counts = Counter()
edges  = Counter()
agents = Counter()

def classify_ua(ua):
    if 'Edg/' in ua or 'EdgA/' in ua: b = 'Edge'
    elif 'Chrome' in ua:               b = 'Chrome'
    elif 'Firefox' in ua:              b = 'Firefox'
    elif 'Safari' in ua:               b = 'Safari'
    elif ua.lower().startswith('curl'): b = 'curl'
    elif 'python' in ua.lower():       b = 'Python'
    elif 'Wget' in ua:                 b = 'Wget'
    else:                              b = (ua.split('/')[0] or 'Unknown')[:18]
    if   'iPhone' in ua or 'iPad' in ua: p = 'iOS'
    elif 'Android' in ua:                p = 'Android'
    elif 'Macintosh' in ua:              p = 'macOS'
    elif 'Windows' in ua:               p = 'Windows'
    elif 'Linux' in ua:                 p = 'Linux'
    else:                               p = 'Unknown'
    return f'{b} / {p}'

for fname in sorted(os.listdir(tmp_dir)):
    if not fname.endswith('.gz'): continue
    try:
        with gzip.open(os.path.join(tmp_dir, fname), 'rt', errors='replace') as f:
            for line in f:
                if line.startswith('#') or not line.strip(): continue
                p = line.strip().split('\t')
                if len(p) < 11: continue
                date, time, edge, ip = p[0], p[1][:8], p[2], p[4]
                uri, status, ua_raw  = p[7], p[8], p[10]
                parts = uri.strip('/').split('/')
                if len(parts) < 2 or not parts[0].isdigit(): continue
                token = parts[1]
                if filt and filt not in token and filt not in uri: continue
                ua  = urllib.parse.unquote(ua_raw)
                dt  = f'{date} {time}'
                hits[token]  += 1
                uniq[token].add(ip)
                first[token]  = min(first.get(token, dt), dt)
                last[token]   = max(last.get(token,  dt), dt)
                status_counts[status] += 1
                edges[edge]  += 1
                agents[classify_ua(ua)] += 1
    except Exception:
        continue

total_hits = sum(hits.values())
total_ips  = len(set(ip for s in uniq.values() for ip in s))

if not total_hits:
    print('  No matching requests found.')
    sys.exit(0)

W = 90
def rule(): print('  ' + '─' * W)

print(f'  Total requests : {total_hits}')
print(f'  Unique IPs     : {total_ips}')
print(f'  Unique tokens  : {len(hits)}')

print()
print(f'  {"TOKEN":<10}  {"FILE":<28}  {"HITS":>5}  {"UNIQ IPs":>8}  {"FIRST ACCESS":<19}  LAST ACCESS')
rule()
for token, h in sorted(hits.items(), key=lambda x: -x[1]):
    fname = names.get(token, '')[:28]
    print(f'  {token:<10}  {fname:<28}  {h:>5}  {len(uniq[token]):>8}  {first[token]:<19}  {last[token]}')

STATUS_LABEL = {
    '200': 'OK', '204': 'No Content', '206': 'Partial', '304': 'Not Modified',
    '400': 'Bad Request', '403': 'Forbidden', '404': 'Not Found',
    '410': 'Gone (expired)', '499': 'Client abort', '502': 'Bad Gateway',
}
print()
print('  HTTP statuses:')
for s, c in sorted(status_counts.items()):
    print(f'    {s}  {STATUS_LABEL.get(s,""):<22}  {c}')

print()
print('  Top edge locations (rough geography):')
for e, c in edges.most_common(8):
    print(f'    {e:<18}  {c}')

print()
print('  Client breakdown:')
for a, c in agents.most_common(10):
    print(f'    {a:<32}  {c}')
PYEOF

    rm -rf "$tmp_dir"
    echo ""
}

# ── teardown ──────────────────────────────────────────────────────────────────

cmd_teardown() {
    load_config
    echo ""
    warn "This permanently deletes all tinyshare AWS resources."
    echo ""

    if [[ -n "${TINYSHARE_CF_STACK:-}" ]]; then
        echo "    CloudFormation stack: $TINYSHARE_CF_STACK"
        echo "    S3 bucket:           $TINYSHARE_BUCKET (and all files)"
        echo ""
        read -r -p "  Type 'delete' to confirm: " ans
        [[ "$ans" == "delete" ]] || { echo "Aborted."; exit 0; }

        info "Emptying S3 bucket first..."
        aws s3 rm "s3://${TINYSHARE_BUCKET}" --recursive \
            --region "$TINYSHARE_REGION" 2>/dev/null || true

        info "Deleting CloudFormation stack (a few minutes)..."
        aws cloudformation delete-stack \
            --stack-name "$TINYSHARE_CF_STACK" \
            --region us-east-1
        aws cloudformation wait stack-delete-complete \
            --stack-name "$TINYSHARE_CF_STACK" \
            --region us-east-1

        local log_bucket="${TINYSHARE_BUCKET}-logs"
        if aws s3api head-bucket --bucket "$log_bucket" --region us-east-1 2>/dev/null; then
            echo ""
            warn "Log bucket s3://${log_bucket} was retained (contains your access logs)."
            if confirm "Delete log bucket and all logs?"; then
                aws s3 rm "s3://${log_bucket}" --recursive --region us-east-1 2>/dev/null || true
                aws s3api delete-bucket --bucket "$log_bucket" --region us-east-1
                info "Log bucket deleted."
            fi
        fi
    else
        # Legacy: manually provisioned (pre-CloudFormation setup)
        echo "    CloudFront dist: $TINYSHARE_CF_DIST_ID"
        echo "    S3 bucket:       $TINYSHARE_BUCKET (and all files)"
        echo ""
        read -r -p "  Type 'delete' to confirm: " ans
        [[ "$ans" == "delete" ]] || { echo "Aborted."; exit 0; }

        info "Disabling CloudFront distribution..."
        local DIST_ETAG DIST_CFG DISABLED
        DIST_ETAG=$(aws cloudfront get-distribution-config \
            --id "$TINYSHARE_CF_DIST_ID" --query 'ETag' --output text)
        DIST_CFG=$(aws cloudfront get-distribution-config \
            --id "$TINYSHARE_CF_DIST_ID" --query 'DistributionConfig')
        DISABLED=$(echo "$DIST_CFG" | python3 -c \
            "import sys,json; d=json.load(sys.stdin); d['Enabled']=False; print(json.dumps(d))")
        aws cloudfront update-distribution \
            --id "$TINYSHARE_CF_DIST_ID" \
            --distribution-config "$DISABLED" \
            --if-match "$DIST_ETAG" > /dev/null
        info "Waiting for distribution to disable..."
        aws cloudfront wait distribution-deployed --id "$TINYSHARE_CF_DIST_ID"
        DIST_ETAG=$(aws cloudfront get-distribution \
            --id "$TINYSHARE_CF_DIST_ID" --query 'ETag' --output text)
        aws cloudfront delete-distribution \
            --id "$TINYSHARE_CF_DIST_ID" --if-match "$DIST_ETAG"

        info "Emptying and deleting S3 bucket..."
        aws s3 rm "s3://${TINYSHARE_BUCKET}" --recursive --region "$TINYSHARE_REGION" > /dev/null
        aws s3api delete-bucket --bucket "$TINYSHARE_BUCKET" --region "$TINYSHARE_REGION"
        warn "DNS records in Route 53 were not removed — delete them manually if needed."
    fi

    rm -f "$CONFIG_FILE"
    echo ""
    info "Teardown complete."
    echo ""
}

# ── delete-config ─────────────────────────────────────────────────────────────

cmd_delete_config() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        printf '\nNo config found at %s\n\n' "$CONFIG_FILE"
        exit 0
    fi
    printf '\nThis removes the local config only — AWS resources are NOT deleted.\n'
    printf 'To also delete AWS resources, run: share teardown\n\n'
    confirm "Remove $CONFIG_FILE?" || exit 0
    rm -f "$CONFIG_FILE"
    echo ""
    info "Config removed. Run 'share setup' to reconfigure."
    echo ""
}

# ── uninstall ─────────────────────────────────────────────────────────────────

cmd_uninstall() {
    local bin_path
    bin_path=$(command -v share 2>/dev/null || true)
    [[ -n "$bin_path" ]] || die "share not found in PATH"
    confirm "Remove $bin_path?" || exit 0
    rm "$bin_path"
    info "Removed $bin_path"
    info "Config at $CONFIG_DIR was not removed."
}

# ── qr ───────────────────────────────────────────────────────────────────────

cmd_qr() {
    load_config
    local arg="${1:-}"
    [[ -n "$arg" ]] || die "Usage: share qr <token|url>"

    local url
    if [[ "$arg" == https://* ]]; then
        url="$arg"
    else
        local key
        key=$(aws s3 ls "s3://${TINYSHARE_BUCKET}/" --recursive --region "$TINYSHARE_REGION" \
            | awk '{print $NF}' | grep "/${arg}$" | head -1)
        [[ -n "$key" ]] || die "Share not found: $arg"
        url="https://${TINYSHARE_DOMAIN}/${key}"
    fi

    printf '\n  %s\n' "$url"
    show_qr "$url"
    echo ""
}

# ── connect ───────────────────────────────────────────────────────────────────

cmd_connect() {
    echo ""
    echo "  tinyshare connect"
    echo "  ─────────────────"
    echo ""

    command -v aws &>/dev/null || die "aws CLI not found — install it: https://aws.amazon.com/cli/"

    if [[ -f "$CONFIG_FILE" ]]; then
        warn "Already configured ($CONFIG_FILE exists)."
        confirm "Overwrite with imported config?" || exit 0
        echo ""
    fi

    # ── AWS profile ───────────────────────────────────────────────────────────
    local profiles profile_count PROFILE
    profiles=()
    while IFS= read -r _line; do [[ -n "$_line" ]] && profiles+=("$_line"); done \
        < <(aws configure list-profiles 2>/dev/null || echo "default")
    profile_count=${#profiles[@]}

    if (( profile_count == 1 )); then
        PROFILE="${profiles[0]}"
        echo "  AWS profile: ${BOLD}${PROFILE}${NC}"
    else
        echo "  AWS profiles:"
        for i in "${!profiles[@]}"; do
            printf "    [%d] %s\n" $(( i + 1 )) "${profiles[$i]}"
        done
        echo ""
        read -r -p "  Select profile [1]: " _idx
        _idx="${_idx:-1}"
        [[ "$_idx" =~ ^[0-9]+$ ]] && (( _idx >= 1 && _idx <= profile_count )) \
            || die "Invalid selection"
        PROFILE="${profiles[$(( _idx - 1 ))]}"
    fi
    export AWS_PROFILE="$PROFILE"
    echo ""

    # ── Discover stacks ───────────────────────────────────────────────────────
    info "Looking for tinyshare deployments..."
    local stacks_json
    stacks_json=$(aws cloudformation describe-stacks --region us-east-1 --output json 2>/dev/null) \
        || die "Could not list CloudFormation stacks — check your AWS credentials"

    local stack_names stack_domains
    stack_names=()
    stack_domains=()
    while IFS=$'\t' read -r _name _domain; do
        [[ -n "$_name" ]] && stack_names+=("$_name") && stack_domains+=("$_domain")
    done < <(echo "$stacks_json" | python3 -c "
import sys, json
data = json.load(sys.stdin)
for s in data.get('Stacks', []):
    tags = {t['Key']: t['Value'] for t in s.get('Tags', [])}
    if tags.get('tinyshare:managed') != 'true': continue
    if s.get('StackStatus', '').endswith('_IN_PROGRESS'): continue
    outputs = {o['OutputKey']: o['OutputValue'] for o in s.get('Outputs', [])}
    domain = outputs.get('ShareUrl', '').replace('https://', '')
    print(s['StackName'] + '\t' + domain)
")

    local stack_count=${#stack_names[@]}
    if (( stack_count == 0 )); then
        echo "  No tinyshare deployments found for this AWS profile."
        echo ""
        echo "  To deploy a new one: share setup"
        echo ""
        exit 0
    fi

    local STACK_NAME DOMAIN
    if (( stack_count == 1 )); then
        STACK_NAME="${stack_names[0]}"
        DOMAIN="${stack_domains[0]}"
        echo "  Found: ${BOLD}${DOMAIN}${NC}  (${STACK_NAME})"
        echo ""
    else
        echo "  Found tinyshare deployments:"
        for i in "${!stack_names[@]}"; do
            printf "    [%d] %-30s  %s\n" $(( i + 1 )) "${stack_domains[$i]}" "${stack_names[$i]}"
        done
        echo ""
        read -r -p "  Select [1]: " _idx
        _idx="${_idx:-1}"
        [[ "$_idx" =~ ^[0-9]+$ ]] && (( _idx >= 1 && _idx <= stack_count )) \
            || die "Invalid selection"
        STACK_NAME="${stack_names[$(( _idx - 1 ))]}"
        DOMAIN="${stack_domains[$(( _idx - 1 ))]}"
    fi

    # ── Extract outputs ───────────────────────────────────────────────────────
    local OUTPUTS BUCKET DIST_ID KVS_ARN
    OUTPUTS=$(aws cloudformation describe-stacks \
        --stack-name "$STACK_NAME" \
        --region us-east-1 \
        --query 'Stacks[0].Outputs' \
        --output json)
    BUCKET=$(echo "$OUTPUTS" | python3 -c "
import sys, json
o = {x['OutputKey']: x['OutputValue'] for x in json.load(sys.stdin)}
print(o.get('BucketName', ''))
")
    DIST_ID=$(echo "$OUTPUTS" | python3 -c "
import sys, json
o = {x['OutputKey']: x['OutputValue'] for x in json.load(sys.stdin)}
print(o.get('DistributionId', ''))
")
    KVS_ARN=$(echo "$OUTPUTS" | python3 -c "
import sys, json
o = {x['OutputKey']: x['OutputValue'] for x in json.load(sys.stdin)}
print(o.get('KeyValueStoreArn', ''))
")

    [[ -n "$BUCKET" && -n "$DIST_ID" && -n "$DOMAIN" ]] \
        || die "Could not read stack outputs — stack may still be deploying"

    # ── Write config ──────────────────────────────────────────────────────────
    mkdir -p "$CONFIG_DIR"
    {
        echo "TINYSHARE_BUCKET=$BUCKET"
        echo "TINYSHARE_DOMAIN=$DOMAIN"
        echo "TINYSHARE_REGION=us-east-1"
        echo "TINYSHARE_CF_DIST_ID=$DIST_ID"
        echo "TINYSHARE_CF_STACK=$STACK_NAME"
        echo "TINYSHARE_AWS_PROFILE=$PROFILE"
        [[ -n "$KVS_ARN" ]] && echo "TINYSHARE_KVS_ARN=$KVS_ARN"
    } > "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"

    echo ""
    info "Connected to ${DOMAIN}"
    echo ""
    echo "  Try it:  share photo.jpg 7d"
    echo ""
}

# ── help ──────────────────────────────────────────────────────────────────────

cmd_help() {
    cat <<EOF

  ${BOLD}tinyshare${NC} — create time-limited file share links via S3 + CloudFront

  ${BOLD}USAGE${NC}
    share setup                          One-time AWS setup via CloudFormation
    share connect                        Import config from an existing deployment
    share <file> [duration]              Upload file and print a share URL
    share <file> [duration] --qr         Upload and also display a QR code
    share <file> [duration] --alias=NAME Upload with a custom vanity alias
    share qr <token|url>                 Display QR code for an existing share
    share list                           List all shares and their status
    share revoke <token|alias>           Delete a share immediately
    share logs [token]                   Show raw access log rows
    share stats [token]                  Aggregate stats: hits, IPs, browsers, edges
    share teardown                       Destroy all AWS infrastructure
    share delete-config                  Remove local config (keeps AWS resources)
    share uninstall                      Remove share from PATH
    share help                           Show this help

  ${BOLD}DURATION${NC}
    1h  6h  24h (default)  7d  30d

  ${BOLD}EXAMPLES${NC}
    share report.pdf             Share for 24 hours
    share photo.jpg 7d           Share for 7 days
    share photo.jpg 7d --qr      Share and show QR code
    share photo.jpg 7d --alias=oreo  Share with alias → https://domain/oreo
    share archive.zip 1h         Share for 1 hour
    share qr aB3xKm9P            Show QR for an existing share
    share list                   Show all shares
    share revoke aB3xKm9P        Immediately delete a share
    share revoke oreo            Immediately delete a share by alias

  ${BOLD}CONFIG${NC}
    $CONFIG_FILE

EOF
}

# ── dispatch ──────────────────────────────────────────────────────────────────

CMD="${1:-help}"
shift || true

case "$CMD" in
    setup)             cmd_setup ;;
    connect)           cmd_connect ;;
    list)              cmd_list ;;
    revoke)            cmd_revoke "${1:-}" ;;
    logs)              cmd_logs "${1:-}" ;;
    stats)             cmd_stats "${1:-}" ;;
    teardown)          cmd_teardown ;;
    delete-config)     cmd_delete_config ;;
    uninstall)         cmd_uninstall ;;
    help|--help|-h)    cmd_help ;;
    qr)                cmd_qr "${1:-}" ;;
    *)                 cmd_upload "$CMD" "$@" ;;
esac
